{
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/dashboard",
      "destination": "/public/dashboard.html"
    },
    {
      "source": "/:path*",
      "destination": "/public/:path*"
    }
  ]
}
