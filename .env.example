# Claude API Configuration
# Get your key from: https://console.anthropic.com/account/keys
# IMPORTANT: Generate a NEW key, never reuse a shared key
CLAUDE_API_KEY=sk-ant-api03-YOUR_NEW_KEY_HERE

# Paperclip Configuration (optional)
# PAPERCLIP_API_KEY=your-paperclip-api-key-here

# Environment
NODE_ENV=production

# Server
PORT=3000

# Optional: Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Optional: Cost tracking
CLAUDE_API_MONTHLY_BUDGET=100
CLAUDE_API_PROJECT_LIMIT=10

# Optional: Logging
LOG_LEVEL=info
